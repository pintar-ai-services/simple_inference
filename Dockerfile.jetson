# Build this image natively on a Jetson through scripts/jetson-compose.sh.
# The script selects an L4T base image and exact ARM64 wheels for the host's
# JetPack release; do not use a generic PyPI CUDA wheel on Jetson.
ARG L4T_BASE=nvcr.io/nvidia/l4t-jetpack:r36.4.0
FROM ${L4T_BASE}

ARG PYTHON_BIN=python3
ARG NUMPY_VERSION=
ARG TORCH_WHEEL_FILENAME
ARG TORCH_WHEEL_URLS
ARG TORCHVISION_WHEEL_FILENAME
ARG TORCHVISION_WHEEL_URLS
ARG CUSPARSELT_REQUIRED=0
ARG CUDA_VERSION

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda/targets/aarch64-linux/lib

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libgomp1 \
        libopenblas-dev \
        python3-dev \
        python3-pip \
        tar \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
COPY scripts/fetch-jetson-wheel.sh /usr/local/bin/fetch-jetson-wheel

# The URLs are a whitespace-separated, ordered fallback list.  They are set
# only by scripts/jetson-compose.sh, which derives them from the launcher
# manifest.  Installing from a downloaded file keeps pip from resolving an
# incompatible generic torch wheel.
RUN set -eu; \
    ${PYTHON_BIN} -m pip install --upgrade 'pip<25' 'setuptools<82' wheel; \
    if [ -n "${NUMPY_VERSION}" ]; then ${PYTHON_BIN} -m pip install "numpy==${NUMPY_VERSION}"; fi; \
    sh /usr/local/bin/fetch-jetson-wheel /tmp "${TORCH_WHEEL_FILENAME}" "${TORCH_WHEEL_URLS}"; \
    ${PYTHON_BIN} -m pip install "/tmp/${TORCH_WHEEL_FILENAME}"; \
    rm -f "/tmp/${TORCH_WHEEL_FILENAME}"; \
    sh /usr/local/bin/fetch-jetson-wheel /tmp "${TORCHVISION_WHEEL_FILENAME}" "${TORCHVISION_WHEEL_URLS}"; \
    ${PYTHON_BIN} -m pip install "/tmp/${TORCHVISION_WHEEL_FILENAME}"; \
    rm -f "/tmp/${TORCHVISION_WHEEL_FILENAME}"; \
    if [ "${CUSPARSELT_REQUIRED}" = "1" ] && ! ldconfig -p | grep -q libcusparseLt; then \
      archive=libcusparse_lt-linux-sbsa-0.5.2.1-archive.tar.xz; \
      curl --fail --location --retry 2 --retry-all-errors \
        --output /tmp/${archive} \
        https://developer.download.nvidia.com/compute/cusparselt/redist/libcusparse_lt/linux-sbsa/${archive}; \
      mkdir -p /tmp/cusparselt /usr/local/cuda/include /usr/local/cuda/lib64; \
      tar -xf /tmp/${archive} -C /tmp/cusparselt; \
      cp -a /tmp/cusparselt/libcusparse_lt-linux-sbsa-0.5.2.1-archive/include/. /usr/local/cuda/include/; \
      cp -a /tmp/cusparselt/libcusparse_lt-linux-sbsa-0.5.2.1-archive/lib/. /usr/local/cuda/lib64/; \
      ldconfig; \
      rm -rf /tmp/${archive} /tmp/cusparselt; \
    fi; \
    ${PYTHON_BIN} -m pip install -r requirements.txt; \
    ${PYTHON_BIN} -c 'import torch, torchvision; print(f"Jetson PyTorch installed: torch={torch.__version__}, torchvision={torchvision.__version__}, CUDA={torch.version.cuda}")'

COPY app ./app
